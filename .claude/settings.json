{
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Bash(git *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "Bash(bun *)",
      "Bash(node *)",
      "Bash(tsc *)",
      "Bash(vitest *)",
      "Bash(playwright *)",
      "Bash(eslint *)",
      "Bash(prettier *)",
      "Bash(diff *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "npx tsc --noEmit --pretty false 2>&1 | grep -E '^src/(app|components|lib|hooks)/' | grep -v '__tests__' | head -20 | { errors=$(cat); if [ -n \"$errors\" ]; then echo \"{\\\"decision\\\": \\\"block\\\", \\\"reason\\\": \\\"TypeScript errors in src/:\\n$errors\\\"}\"; else echo '{}'; fi; }",
            "timeout": 60,
            "statusMessage": "Vérification TypeScript..."
          }
        ]
      }
    ]
  }
}
