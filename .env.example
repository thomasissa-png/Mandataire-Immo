# ============================================
# Variables d'environnement ImmoCrew
# Copier ce fichier en .env.local pour le dev
# En production : configurer dans Replit Secrets
# ============================================

# --- Database (Replit PostgreSQL) ---
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- NextAuth ---
# Generer avec : openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# --- Stripe ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MENSUEL=price_xxx
STRIPE_PRICE_TRIMESTRIEL=price_xxx
STRIPE_PRICE_ANNUEL=price_xxx
STRIPE_PRICE_BOOST=price_xxx

# --- Anthropic (Claude API) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- OpenAI (gpt-image-1 pour home staging) ---
OPENAI_API_KEY=sk-...

# --- Analytics ---
# Umami Cloud (pas de clé nécessaire côté serveur, le script est public)
# Website ID configuré dans src/lib/tracking.ts et src/app/layout.tsx

# --- Sentry ---
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_AUTH_TOKEN=sntrys_...

# --- Resend (envoi d'emails) ---
# Sans cette cle, les emails sont logues en console (mode dev)
RESEND_API_KEY=re_...

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_EMAIL=admin@immocrew.fr

# --- Cron (generation automatique d'articles SEO) ---
# Secret partage avec le service cron externe (Replit Cron ou cron-job.org)
# Generer avec : openssl rand -hex 32
CRON_SECRET=your-cron-secret-here
